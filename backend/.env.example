# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ytinsight
# SECRET_KEY=generate-a-long-random-string-here
# YOUTUBE_API_KEY=AIza...your_youtube_api_key
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# DAILY_LIMIT=5
# MAX_COMMENTS=500

# # Google OAuth (get from console.cloud.google.com)
# GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# # SendGrid (leave blank to use dummy/log mode for local dev)
# SENDGRID_API_KEY=
# SENDGRID_FROM_EMAIL=noreply@commentcompass.app


# ── Local development (ENV defaults to development) ──
DATABASE_URL=postgresql://postgres:postgres@db:5432/ytinsight
SECRET_KEY=any-long-random-string-for-local-use
YOUTUBE_API_KEY=your-youtube-data-api-v3-key
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
DAILY_LIMIT=5
MAX_COMMENTS=500
APP_URL=http://localhost:3000
ADMIN_EMAIL=admin@commentcompass.app
ADMIN_PASSWORD=choose-a-strong-password
GOOGLE_CLIENT_ID=
# Brevo API key must start with xkeysib-
BREVO_API_KEY=
BREVO_FROM_EMAIL=

# ── Production only (set these in Render's dashboard, not in a file) ──
# ENV=production     turns on the safety checks and hides /docs
# SECRET_KEY         must be 32+ characters:  openssl rand -hex 32
# ADMIN_PASSWORD     must be 12+ characters
# CORS_ORIGINS       must be your exact Vercel URL, e.g. https://comment-compass.vercel.app